  },
  {
   "id": "ia0034",
   "type": "text",
   "x": 598,
   "y": 379.0,
   "width": 371.28,
   "height": 162.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
