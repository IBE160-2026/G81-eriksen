   "text": "Ingen grønne turer passer søket [ANTAKELSE]",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 15,
   "containerId": null,
   "originalText": "Ingen grønne turer passer søket [ANTAKELSE]",
