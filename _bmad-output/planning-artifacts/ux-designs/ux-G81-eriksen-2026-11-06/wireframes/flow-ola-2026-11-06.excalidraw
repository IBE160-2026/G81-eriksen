   "boundElements": null,
   "updated": 1762423200000,
   "link": null,
   "locked": false,
   "text": "KLIMAKS – «ja, den tar jeg»\nIllustrasjon (rute + høydeprofil), kart og turtype-treff («Utsikt – som\ndu ba om») er synlige samtidig over folden (stiplet oransje). Treffet\nstår også i begrunnelsen. Kreditering nederst på kartet; ut.no-lenken\nvises bare hvis turen har en.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 71,
   "containerId": null,
   "originalText": "KLIMAKS – «ja, den tar jeg»\nIllustrasjon (rute + høydeprofil), kart og turtype-treff («Utsikt – som\ndu ba om») er synlige samtidig over folden (stiplet oransje). Treffet\nstår også i begrunnelsen. Kreditering nederst på kartet; ut.no-lenken\nvises bare hvis turen har en.",
   "lineHeight": 1.25,
   "autoResize": true,
   "index": "b18"
  },
